# Copy this file to .env and fill in real values -- .env is already in
# .gitignore, so it is never committed. app.py and poller.py load it
# automatically at startup (config.load_dotenv()); a real environment
# variable set some other way (shell, CI, a process manager) always
# takes precedence over whatever is in this file.
#
# Every line is KEY=value. Blank lines and #-comments are ignored.
# Quoting a value ("like this") is optional -- one matching pair of
# quotes is stripped if present.

# Which primary source pipeline.build_collectors() uses:
# demo (default) | the-odds-api | api-football
ODDS_SOURCE=demo

# --- the-odds-api.com ---
ODDS_API_KEY=
ODDS_SPORT_KEY=soccer_epl
# auto (default, fetches over HTTP) | manual (reads ODDS_API_CAPTURE_DIR)
ODDS_API_MODE=auto
ODDS_API_CAPTURE_DIR=

# --- api-football.com (api-sports.io) ---
API_FOOTBALL_KEY=

# --- Mozzart (manual capture only -- Cloudflare blocks automated fetch) ---
MOZZART_CAPTURE_DIR=
MOZZART_MODE=manual

# --- Add another real provider's key here the same way, one line each,
# as more sources are wired into pipeline.py -- no other change to this
# file's format is needed. ---

# --- Persistence / detection thresholds ---
DB_PATH=
MIN_VALUE_GAP_PERCENT=15.0
SIGNAL_TTL_HOURS=3
MIN_SUREBET_PROFIT_PERCENT=1.0
# Production FreshnessPolicy (any ODDS_SOURCE other than demo) -- tune
# relative to your actual POLL_INTERVAL_SECONDS and how stale a given
# provider's own "update" timestamp tends to be by the time it's
# fetched. Demo mode ignores these (see pipeline.DEMO_FRESHNESS_POLICY).
MAX_QUOTE_AGE_MINUTES=60
MAX_QUOTE_SPREAD_MINUTES=30

# --- poller.py ---
POLL_INTERVAL_SECONDS=300
