# Copy this file to .env and fill in real values -- .env is already in
# .gitignore, so it is never committed. app.py and poller.py load it
# automatically at startup (config.load_dotenv()); a real environment
# variable set some other way (shell, CI, a process manager) always
# takes precedence over whatever is in this file.
#
# Every line is KEY=value. Blank lines and #-comments are ignored.
# Quoting a value ("like this") is optional -- one matching pair of
# quotes is stripped if present.

# Which primary source pipeline.build_collectors() uses:
# demo (default) | the-odds-api | api-football
ODDS_SOURCE=demo

# --- the-odds-api.com ---
ODDS_API_KEY=
ODDS_SPORT_KEY=soccer_epl
# auto (default, fetches over HTTP) | manual (reads ODDS_API_CAPTURE_DIR)
ODDS_API_MODE=auto
ODDS_API_CAPTURE_DIR=
# When ODDS_API_KEY is set and ODDS_SOURCE is something else (api-football,
# demo), the-odds-api is polled as a rate-limited supplemental source, not
# every cycle like every other collector -- its free tier is ~500
# requests/MONTH, not api-football's 100/day. Minimum hours between polls:
ODDS_API_MIN_INTERVAL_HOURS=4

# --- api-football.com (api-sports.io) ---
API_FOOTBALL_KEY=

# --- Mozzart (manual capture only -- Cloudflare blocks automated fetch) ---
MOZZART_CAPTURE_DIR=
MOZZART_MODE=manual

# --- Meridianbet (manual capture, same drop-file mechanism as Mozzart --
# see MeridianbetFileCollector -- or MERIDIANBET_MODE=http for the
# automatic collector against meridianbet.rs's own anonymous-visitor
# endpoint, no key/capture dir needed -- see MeridianbetHttpCollector) ---
MERIDIANBET_CAPTURE_DIR=
MERIDIANBET_MODE=manual
# Only consulted when MERIDIANBET_MODE=http -- see AppConfig.
# meridianbet_http_min_interval for why this is rate-limited separately
# from POLL_INTERVAL_SECONDS. 0.5h matches the burst window's own
# BURST_INTERVAL_SECONDS below, so this stops being the binding
# constraint during burst (no API key/quota exists for this source to
# protect, unlike the-odds-api's equivalent setting above).
MERIDIANBET_HTTP_MIN_INTERVAL_HOURS=0.5

# --- Add another real provider's key here the same way, one line each,
# as more sources are wired into pipeline.py -- no other change to this
# file's format is needed. ---

# --- Persistence / detection thresholds ---
DB_PATH=
MIN_VALUE_GAP_PERCENT=15.0
SIGNAL_TTL_HOURS=3
MIN_SUREBET_PROFIT_PERCENT=1.0
# Production FreshnessPolicy (any ODDS_SOURCE other than demo) -- tune
# relative to your actual POLL_INTERVAL_SECONDS and how stale a given
# provider's own "update" timestamp tends to be by the time it's
# fetched. Demo mode ignores these (see pipeline.DEMO_FRESHNESS_POLICY).
MAX_QUOTE_AGE_MINUTES=60
MAX_QUOTE_SPREAD_MINUTES=30

# --- poller.py ---
POLL_INTERVAL_SECONDS=300

# Optional burst window: poll at BURST_INTERVAL_SECONDS instead of
# POLL_INTERVAL_SECONDS during [BURST_START_HOUR, BURST_END_HOUR) local
# time each day (end hour is exclusive), then fall back to the normal
# interval the rest of the day -- e.g. tripling the rate through the
# day's real match-kickoff peak without blowing a fixed daily API
# request budget the other 21 hours. Both hours must be set together,
# 0 <= start < end <= 24, or poller.py raises at startup. Leave both
# unset (default) to disable -- POLL_INTERVAL_SECONDS then applies all
# day, exactly as before this existed.
#
# 15-18 below is empirically derived, not a guess: grouping this
# project's own recorded `movements` by hours-until-kickoff showed every
# pre-match bucket from 48h out down to 0-1h before is essentially flat
# (~14% median |change|) -- the real action is concentrated right at
# market close/kickoff, not a gradual pre-match drift -- and grouping by
# UTC hour-of-day, normalized by poll count (moves per poll, not raw
# count, which is confounded by how often each hour happened to be
# polled), peaked sharply at UTC 13 and UTC 15 (local 15/17 at UTC+2) --
# a different 3h window than an earlier, un-measured 18-21 guess. Same
# window width (keeps the daily request budget unchanged, just
# relocated) -- re-derive this from a longer data run before trusting it
# as more than a strong first cut.
# BURST_START_HOUR=15
# BURST_END_HOUR=18
# BURST_INTERVAL_SECONDS=1800
